<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP01" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP01">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Dữ liệu gốc" processRef="Process_BP01" />
    <bpmn:participant id="P_NCC" name="Đối tác (NCC / khách hàng / đại lý)" />
    <bpmn:messageFlow id="MF_1" name="Gọi lại xác minh" sourceRef="T5" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_2" name="Xác nhận của đối tác" sourceRef="P_NCC" targetRef="T5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP01" name="BP-01 Quản lý dữ liệu gốc: tạo và thay đổi danh mục có kiểm soát" isExecutable="false">
    <bpmn:documentation>Mỗi đối tượng (khách hàng, đại lý, nhà cung cấp, dịch vụ, điểm đến, hướng dẫn viên) chỉ có một mã dùng chung toàn công ty, được nhập một lần tại nguồn, có người kiểm tra trước khi dùng cho giao dịch.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP01">
      <bpmn:lane id="Lane_REQ" name="Bộ phận đề nghị">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MDM" name="Quản trị dữ liệu gốc">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Cần đối tác hoặc dịch vụ mới, hoặc cần đổi thông tin">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M0" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T1" name="Lập yêu cầu tạo/sửa danh mục, đính kèm hồ sơ">
      <bpmn:documentation>Chọn loại danh mục; nhập trường bắt buộc theo loại; đính kèm giấy phép kinh doanh, mã số thuế, xác nhận tài khoản ngân hàng, hợp đồng (nếu có).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Kiểm tra trùng và hợp lệ">
      <bpmn:documentation>So khóa chống trùng (mã số thuế, CCCD/hộ chiếu, số điện thoại, email, số tài khoản); kiểm tra định dạng và trường bắt buộc; tra cứu trạng thái mã số thuế nếu có tích hợp.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Hợp lệ và không trùng?" default="Flow_6">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Thẩm định, chuẩn hóa dữ liệu">
      <bpmn:documentation>Chuẩn hóa tên, phân loại, nhóm, khu vực, đơn vị tiền tệ; đối chiếu hồ sơ đính kèm.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Đạt chuẩn?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Có thông tin tài chính?" default="Flow_11">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Duyệt thông tin tài chính, xác minh tài khoản ngân hàng">
      <bpmn:documentation>Tài khoản ngân hàng, điều khoản thanh toán, hạn mức công nợ. Đổi tài khoản ngân hàng NCC: gọi lại số điện thoại đã lưu trong hồ sơ (không dùng số trong email yêu cầu).</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="Duyệt?" default="Flow_13">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Yêu cầu bị từ chối">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Kích hoạt bản ghi, lưu phiên bản, đồng bộ module">
      <bpmn:documentation>Bản ghi chuyển Đang dùng; lưu giá trị cũ/mới, người duyệt, thời điểm; thông báo người yêu cầu.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Danh mục sẵn sàng dùng">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="M0" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="M0" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="G1" targetRef="M0" name="Không - trả về">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không - trả về</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G1" targetRef="T4" name="Có" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T4" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="G3" targetRef="M0" name="Chưa đạt - trả lại">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đạt - trả lại</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G3" targetRef="G2" name="Đạt" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G2" targetRef="T5" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="G2" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T5" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G4" targetRef="M1" name="Duyệt" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="G4" targetRef="E2" name="Từ chối">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Từ chối</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="M1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T6" targetRef="E1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Một đối tượng một mã; giao dịch chỉ tham chiếu mã (C01-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T4" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người lập yêu cầu không được duyệt; đổi TK ngân hàng phải gọi lại (C01-03, C01-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T5" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Không xóa bản ghi đã có giao dịch, chỉ ngừng dùng (C01-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T6" targetRef="N3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP01" name="BP-01 Quản lý dữ liệu gốc: tạo và thay đổi danh mục có kiểm soát">
    <bpmndi:BPMNPlane id="Plane_BP01" bpmnElement="Collab_BP01">
