      <bpmndi:BPMNEdge id="Assoc_N1_di" bpmnElement="Assoc_N1"><di:waypoint x="1142" y="346" /><di:waypoint x="1142" y="139" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_N2_di" bpmnElement="Assoc_N2"><di:waypoint x="1722" y="574" /><di:waypoint x="1806" y="641" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_N3_di" bpmnElement="Assoc_N3"><di:waypoint x="2192" y="206" /><di:waypoint x="2192" y="139" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
