<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP07" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP07">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Chốt chuyến" processRef="Process_BP07" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:messageFlow id="MF_1" name="Hủy đặt chỗ" sourceRef="T5" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_2" name="Trả chỗ dư" sourceRef="T8" targetRef="P_NCC" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP07" name="BP-07 Chốt chuyến khởi hành và trả chỗ cho nhà cung cấp" isExecutable="false">
    <bpmn:documentation>Tại hạn chốt của mỗi chuyến, quyết định khởi hành hay hủy/gộp dựa trên số khách thực tế và lãi dự kiến, rồi trả quỹ chỗ dư cho NCC trước hạn để không bị tính phí.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP07">
      <bpmn:lane id="Lane_DIR" name="Ban Giám đốc">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SALES_MGR" name="Trưởng phòng Kinh doanh">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đến hạn chốt chuyến (D-N)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Đếm khách đã xác nhận, tính lãi dự kiến">
      <bpmn:documentation>Chỉ đếm booking đã xác nhận (đã cọc hoặc trong hạn mức); lãi dự kiến theo số khách thực tế.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Đủ số khách tối thiểu?" default="Flow_3">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2" name="Đề xuất: gộp, hủy hoặc vẫn chạy">
      <bpmn:documentation>Gộp sang chuyến cùng tuyến gần ngày; hủy; hoặc vẫn chạy kèm lãi/lỗ dự kiến.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Phương án?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Duyệt khởi hành dưới số khách tối thiểu">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Duyệt?" default="Flow_9">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C1" name="BP-13 Thay đổi, hủy booking &amp; hoàn tiền" calledElement="Process_BP13">
      <bpmn:documentation>Thông báo khách, chuyển sang chuyến khác hoặc hoàn tiền theo hợp đồng.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="T5" name="Hủy chuyến, trả toàn bộ quỹ chỗ, báo hủy NCC">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Chuyến đã hủy hoặc gộp">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Bảo đảm khởi hành, tính chỗ dư so với số khách">
      <bpmn:documentation>Chuyến chuyển Bảo đảm khởi hành; khóa nhận booking theo hạn; chỗ dư = quỹ chỗ − nhu cầu thực tế (phòng × đêm, ghế).</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Còn chỗ dư trước hạn trả?" default="Flow_17">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T8" name="Trả chỗ dư cho NCC">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C2" name="BP-08 Đặt dịch vụ &amp; chuẩn bị đoàn" calledElement="Process_BP08">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E1" name="Chuyến sẵn sàng điều hành">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="G1" targetRef="M1" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="G1" targetRef="T2" name="Không đủ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không đủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G2" targetRef="T3" name="Vẫn khởi hành">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Vẫn khởi hành</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="G2" targetRef="M2" name="Hủy hoặc gộp" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T3" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G3" targetRef="M1" name="Duyệt" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G3" targetRef="M2" name="Không duyệt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không duyệt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="M2" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="C1" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T5" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M1" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T4" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="G4" targetRef="T8" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="G4" targetRef="M3" name="Không" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T8" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="M3" targetRef="C2" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="C2" targetRef="E1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Hạn chốt và số khách tối thiểu khai trên từng chuyến (C07-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T1" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Chạy dưới tối thiểu là chấp nhận lỗ: chỉ Giám đốc duyệt (C07-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T3" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Trả trước hạn trả chỗ để không bị tính phí (C07-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T8" targetRef="N3" />
  </bpmn:process>
