<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP10" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP10">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Quyết toán tour" processRef="Process_BP10" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP10" name="BP-10 Quyết toán và đóng hồ sơ tour" isExecutable="false">
    <bpmn:documentation>Có lãi lỗ thực tế của từng tour trong vài ngày sau khi tour kết thúc (không chờ cuối tháng), với đủ chi phí: hóa đơn NCC, chi tại điểm, thù lao HDV, trích trước phần chưa có hóa đơn; rồi đóng hồ sơ khi không còn việc mở.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP10">
      <bpmn:lane id="Lane_GUIDE" name="Hướng dẫn viên">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS_MGR" name="Trưởng Điều hành">
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Tour kết thúc">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T1" name="Nộp bảng kê chi tiêu, chứng từ, hoàn tiền thừa">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T3" name="Đối chiếu dịch vụ thực dùng, ghi nhận tăng giảm">
      <bpmn:documentation>So số lượng HDV xác nhận với đơn đặt dịch vụ; ghi tăng/giảm với NCC.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Kiểm tra chứng từ, quyết toán tạm ứng">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="C2" name="BP-11 Thu tiền &amp; công nợ phải thu" calledElement="Process_BP11">
      <bpmn:documentation>Xuất hóa đơn tại thời điểm hoàn thành dịch vụ (nếu chưa xuất) và thu đủ.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="C3" name="BP-16 HDV cộng tác &amp; chi trả thù lao" calledElement="Process_BP16">
      <bpmn:documentation>Tính và ghi nhận thù lao HDV vào chi phí tour; cấn trừ tạm ứng còn lại.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="C1" name="BP-12 Thanh toán NCC &amp; công nợ phải trả" calledElement="Process_BP12">
      <bpmn:documentation>Nhận và đối chiếu 3 chiều hóa đơn NCC, ghi chi phí vào tour.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G1" name="Đã đủ hóa đơn NCC?" default="Flow_13">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T5" name="Trích trước chi phí theo giá NCC xác nhận">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Lập bảng quyết toán: doanh thu, chi phí thực tế, lãi lỗ">
      <bpmn:documentation>So với dự toán theo từng hạng mục (lưu trú, vận chuyển, vé, ăn, HDV, phát sinh).</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Chênh lệch so dự toán vượt ngưỡng?" default="Flow_18">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Giải trình chênh lệch">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Kiểm tra, xác nhận bảng quyết toán">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Đạt?" default="Flow_24">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M4" name="">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T9" name="Kiểm tra điều kiện đóng hồ sơ">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Đủ điều kiện đóng?" default="Flow_29">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T10" name="Xử lý mục còn mở">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T11" name="Đóng hồ sơ tour">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T12" name="Kết chuyển giá vốn, khóa hồ sơ, cập nhật lãi lỗ">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T12_D1"><bpmn:targetRef>D1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Hồ sơ tour đã đóng">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="P1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P1" targetRef="C2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T2" targetRef="C3" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="C3" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T3" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="C1" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="C2" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="P2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G1" targetRef="T5" name="Chưa đủ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G1" targetRef="M1" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T5" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="M1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="G2" targetRef="M2" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="G2" targetRef="M3" name="Không" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="M2" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T7" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="M3" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T8" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="G3" targetRef="M2" name="Chưa đạt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đạt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="G3" targetRef="M4" name="Đạt" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="M4" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="T9" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="G4" targetRef="T10" name="Chưa đủ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="T10" targetRef="M4" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="G4" targetRef="T11" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="T12" targetRef="E1" />
    <bpmn:dataStoreReference id="D1" name="Sổ cái và sổ chi tiết theo mã tour" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Hóa đơn từ 5 triệu trả tiền mặt: không được khấu trừ (C10-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T2" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người lập quyết toán khác người xác nhận (C10-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T8" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Đủ điều kiện đóng mới được đóng; hồ sơ đóng bị khóa (C10-05, C10-06)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T9" targetRef="N3" />
  </bpmn:process>
