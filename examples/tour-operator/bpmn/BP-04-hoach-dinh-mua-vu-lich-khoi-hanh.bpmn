<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP04" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP04">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — S&amp;OP" processRef="Process_BP04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP04" name="BP-04 Hoạch định mùa vụ và lịch khởi hành (S&amp;OP hằng tháng)" isExecutable="false">
    <bpmn:documentation>Mỗi tháng cân bằng nhu cầu (số khách theo dòng tour) với nguồn cung (quỹ phòng, ghế, HDV, xe) và tài chính, ra một kế hoạch duy nhất được Ban Giám đốc phê duyệt; lịch khởi hành và hợp đồng NCC điều chỉnh theo kế hoạch đó.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP04">
      <bpmn:lane id="Lane_DIR" name="Ban Giám đốc">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SALES_MGR" name="Trưởng phòng Kinh doanh">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROD" name="Sản phẩm &amp; Hợp đồng NCC">
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>T3b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đầu tháng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Tổng hợp booking, lấp đầy, dự báo thống kê">
      <bpmn:documentation>Bước 1: số khách thực tế so với kế hoạch, tỷ lệ lấp đầy từng chuyến, tốc độ đặt chỗ, dự báo thống kê theo dòng tour.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="Lập kế hoạch nhu cầu theo dòng tour và tháng">
      <bpmn:documentation>Bước 2: một con số dự báo chính thức (số khách và doanh thu) cho mỗi dòng tour × tháng; ghi giả định thị trường.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T3a" name="Kế hoạch nguồn cung: quỹ phòng, ghế, hợp đồng">
      <bpmn:documentation>Bước 3: so nhu cầu với quỹ chỗ đã cam kết; xác định thiếu/thừa theo tháng và NCC.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T3b" name="Kế hoạch năng lực: HDV, xe">
      <bpmn:documentation>Bước 3: kiểm tra năng lực sơ bộ (HDV theo ngôn ngữ, xe theo loại) cho số chuyến dự kiến.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T4" name="Quy kế hoạch ra tiền, dòng tiền trả trước NCC">
      <bpmn:documentation>Doanh thu, giá vốn, biên lợi nhuận theo dòng tour; nhu cầu tiền trả trước/ký quỹ NCC theo tháng.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Họp tiền S&amp;OP: khuyến nghị và điểm chưa thống nhất">
      <bpmn:documentation>Bước 4: Kinh doanh, Sản phẩm, Điều hành, Kế toán thống nhất phương án; ghi rõ điểm cần Ban Giám đốc quyết.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Họp S&amp;OP điều hành: duyệt kế hoạch">
      <bpmn:documentation>Bước 5: với từng dòng tour chọn giữ nguyên, đổi kế hoạch bán, hoặc đổi kế hoạch cung; biên bản quyết định.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T6_D1"><bpmn:targetRef>D1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Đổi lịch khởi hành hoặc nguồn cung?" default="Flow_13">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P3" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T7" name="Cập nhật lịch khởi hành, sức chứa, giá theo mùa">
      <bpmn:documentation>Mở/đóng chuyến, đổi sức chứa, cập nhật giá theo mùa; tổng sức chứa theo tháng phải khớp kế hoạch đã duyệt.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="C1" name="BP-02 Hợp đồng NCC &amp; quỹ chỗ" calledElement="Process_BP02">
      <bpmn:documentation>Ký thêm, giảm hoặc trả bớt quỹ chỗ với NCC theo kế hoạch.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P4" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Kế hoạch đã duyệt được công bố">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P1" targetRef="T3a" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="P1" targetRef="T3b" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T3a" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T3b" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="P2" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T6" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G1" targetRef="P3" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G1" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="P3" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="P3" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T7" targetRef="P4" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="C1" targetRef="P4" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="P4" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="M1" targetRef="E1" />
    <bpmn:dataObjectReference id="D1" name="Kế hoạch S&amp;OP đã duyệt" dataObjectRef="DO_D1" />
    <bpmn:dataObject id="DO_D1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Một con số dự báo dùng chung cho mọi phòng ban (C04-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T2" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Họp tối đa 2 giờ, Giám đốc chủ trì (C04-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T6" targetRef="N2" />
  </bpmn:process>
