<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP00" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP00">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — chuỗi giá trị" processRef="Process_BP00" />
    <bpmn:participant id="P_KH" name="Khách hàng / Đại lý / OTA" />
    <bpmn:messageFlow id="MF_1" name="Yêu cầu, đặt chỗ" sourceRef="P_KH" targetRef="S2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP00" name="BP-00 Tổng quan chuỗi giá trị của doanh nghiệp điều hành tour" isExecutable="false">
    <bpmn:documentation>Cho thấy các quy trình BP-01 → BP-16 nối với nhau thế nào: dòng hoạch định (sản phẩm, nguồn cung), dòng đơn hàng của từng đoàn (bán → điều hành → thực hiện → quyết toán → chăm sóc), và dòng tài chính định kỳ.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP00">
      <bpmn:lane id="Lane_DIR" name="Ban Giám đốc">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROD" name="Sản phẩm &amp; Hợp đồng NCC">
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SALES" name="Kinh doanh (Sales / Booking)">
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>C07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GUIDE" name="Hướng dẫn viên">
        <bpmn:flowNodeRef>C09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="Chăm sóc khách hàng">
        <bpmn:flowNodeRef>C14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Chu kỳ hoạch định hằng tháng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:callActivity id="C04" name="BP-04 Hoạch định mùa vụ (S&amp;OP)" calledElement="Process_BP04">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Prop_C04" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_C04_D2"><bpmn:sourceRef>D2</bpmn:sourceRef><bpmn:targetRef>Prop_C04</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_C04_D1"><bpmn:targetRef>D1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="C02" name="BP-02 Hợp đồng NCC &amp; quỹ chỗ" calledElement="Process_BP02">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="C03" name="BP-03 Thiết kế tour &amp; tính giá" calledElement="Process_BP03">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E1" name="Sản phẩm và chỗ sẵn sàng bán">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Khách có nhu cầu">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S2" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="Loại tour?" default="Flow_9">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C05" name="BP-05 Bán tour ghép" calledElement="Process_BP05">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:property id="Prop_C05" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_C05_D1"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>Prop_C05</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_C05_D2"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:callActivity id="C06" name="BP-06 Bán tour thiết kế riêng" calledElement="Process_BP06">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_C06_D2"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:callActivity id="C07" name="BP-07 Chốt chuyến &amp; trả chỗ" calledElement="Process_BP07">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C08" name="BP-08 Đặt dịch vụ &amp; chuẩn bị đoàn" calledElement="Process_BP08">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="C09" name="BP-09 Thực hiện tour &amp; xử lý sự cố" calledElement="Process_BP09">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P3" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="C10" name="BP-10 Quyết toán &amp; đóng hồ sơ tour" calledElement="Process_BP10">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="C14" name="BP-14 CSKH &amp; khiếu nại" calledElement="Process_BP14">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="P4" name="">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E2" name="Đoàn đã phục vụ và quyết toán xong">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S3" name="Cuối tháng">
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S3" />
    </bpmn:startEvent>
    <bpmn:callActivity id="C15" name="BP-15 Khóa sổ cuối kỳ" calledElement="Process_BP15">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E3" name="Kỳ kế toán đã khóa">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="C04" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="C04" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P1" targetRef="C02" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P1" targetRef="C03" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="C02" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="C03" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="P2" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="S2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G1" targetRef="C05" name="Tour ghép" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G1" targetRef="C06" name="Thiết kế riêng">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Thiết kế riêng</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="C05" targetRef="C07" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="C07" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="C06" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M2" targetRef="C08" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="C08" targetRef="C09" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="C09" targetRef="P3" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="P3" targetRef="C10" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="P3" targetRef="C14" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="C10" targetRef="P4" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="C14" targetRef="P4" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="P4" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="S3" targetRef="C15" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="C15" targetRef="E3" />
    <bpmn:dataStoreReference id="D1" name="Lịch khởi hành, quỹ chỗ, giá theo mùa" />
    <bpmn:dataStoreReference id="D2" name="Booking và số liệu bán thực tế" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Mọi quy trình dùng chung danh mục của BP-01 Quản lý dữ liệu gốc</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="C02" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Gọi BP-11 thu cọc và thu đủ; BP-13 khi đổi hoặc hủy</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="C05" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Gọi BP-12 trả trước NCC</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="C08" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Gọi BP-13 khi sự cố làm đổi dịch vụ của khách</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="C09" targetRef="N4" />
    <bpmn:textAnnotation id="N5"><bpmn:text>Gọi BP-11, BP-12, BP-16 để chi phí và công nợ của tour đủ trước khi đóng</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N5" associationDirection="None" sourceRef="C10" targetRef="N5" />
  </bpmn:process>
