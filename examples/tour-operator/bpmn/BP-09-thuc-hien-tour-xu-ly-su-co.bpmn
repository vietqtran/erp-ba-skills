<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP09" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP09">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Thực hiện tour" processRef="Process_BP09" />
    <bpmn:participant id="P_KH" name="Đoàn khách" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:messageFlow id="MF_1" name="Phản ánh, yêu cầu tại chỗ" sourceRef="P_KH" targetRef="SUB1" />
    <bpmn:messageFlow id="MF_2" name="Xác nhận số lượng đã dùng" sourceRef="SUB1" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_3" name="Đổi / đặt bổ sung" sourceRef="T4" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_4" name="Xác nhận" sourceRef="P_NCC" targetRef="T4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP09" name="BP-09 Thực hiện tour và xử lý sự cố" isExecutable="false">
    <bpmn:documentation>Đoàn đi đúng lịch trình; HDV ghi nhận số lượng dịch vụ thực dùng và chi phí phát sinh ngay tại hiện trường; mọi sự cố có người xử lý, hạn xử lý và chi phí được duyệt.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP09">
      <bpmn:lane id="Lane_GUIDE" name="Hướng dẫn viên">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS_MGR" name="Trưởng Điều hành">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Ngày khởi hành (D0)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Đón đoàn, điểm danh trên ứng dụng">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SUB1" name="Thực hiện lịch trình từng ngày">
      <bpmn:documentation>Mỗi ngày: check-in từng mốc; xác nhận số lượng dịch vụ đã dùng (phòng × đêm, suất ăn, vé, xe) với NCC; ghi chi tiêu từ tạm ứng kèm ảnh chứng từ; báo cáo ngày.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Loop_SUB1" />
      <bpmn:startEvent id="SUB1_S" name="Bắt đầu ngày">
        <bpmn:outgoing>SUB1_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SUB1_T1" name="Check-in từng mốc lịch trình">
        <bpmn:documentation>Đến điểm, nhận phòng, bữa ăn, tham quan: bấm check-in theo mốc.</bpmn:documentation>
        <bpmn:incoming>SUB1_F1</bpmn:incoming>
        <bpmn:outgoing>SUB1_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SUB1_T2" name="Xác nhận số lượng dịch vụ đã dùng với NCC">
        <bpmn:documentation>Phòng × đêm, suất ăn, vé, xe theo thực tế; ghi chênh lệch so với đặt chỗ.</bpmn:documentation>
        <bpmn:incoming>SUB1_F2</bpmn:incoming>
        <bpmn:outgoing>SUB1_F3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SUB1_T3" name="Ghi chi tiêu từ tạm ứng kèm ảnh chứng từ">
        <bpmn:incoming>SUB1_F3</bpmn:incoming>
        <bpmn:outgoing>SUB1_F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SUB1_T4" name="Gửi báo cáo ngày">
        <bpmn:documentation>Tình hình đoàn, phản ánh của khách, việc cần Điều hành hỗ trợ.</bpmn:documentation>
        <bpmn:incoming>SUB1_F4</bpmn:incoming>
        <bpmn:outgoing>SUB1_F5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SUB1_E" name="Kết thúc ngày">
        <bpmn:incoming>SUB1_F5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SUB1_F1" sourceRef="SUB1_S" targetRef="SUB1_T1" />
      <bpmn:sequenceFlow id="SUB1_F2" sourceRef="SUB1_T1" targetRef="SUB1_T2" />
      <bpmn:sequenceFlow id="SUB1_F3" sourceRef="SUB1_T2" targetRef="SUB1_T3" />
      <bpmn:sequenceFlow id="SUB1_F4" sourceRef="SUB1_T3" targetRef="SUB1_T4" />
      <bpmn:sequenceFlow id="SUB1_F5" sourceRef="SUB1_T4" targetRef="SUB1_E" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B1" name="Phát sinh sự cố" attachedToRef="SUB1" cancelActivity="false">
      <bpmn:documentation>HDV bấm báo sự cố trên ứng dụng (loại, mức độ, ảnh); tour vẫn tiếp tục.</bpmn:documentation>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="Def_B1" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T7" name="Tiễn đoàn, gửi báo cáo kết thúc tour">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T3" name="Ghi nhận sự cố, phân mức độ, tính hạn xử lý">
      <bpmn:documentation>Hạn xử lý theo mức độ; báo Điều hành phụ trách; quá hạn tự leo thang lên Trưởng Điều hành.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T8" name="Chuyển hồ sơ sang Hoàn thành, mở quyết toán">
      <bpmn:documentation>Khóa nhập nhật ký hiện trường; tạo việc quyết toán tạm ứng; lên lịch gửi khảo sát.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Tour kết thúc">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T4" name="Xử lý: đổi hoặc đặt bổ sung dịch vụ, hỗ trợ đoàn">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Chi phí phát sinh vượt ngưỡng?" default="Flow_10">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Duyệt chi phí phát sinh">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Ảnh hưởng dịch vụ đã bán cho khách?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C1" name="BP-13 Thay đổi, hủy booking &amp; hoàn tiền" calledElement="Process_BP13">
      <bpmn:documentation>Khách xác nhận thay đổi; phụ thu hoặc hoàn tiền.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Đóng sự cố, ghi chi phí vào hồ sơ tour">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Sự cố đã xử lý">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="SUB1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SUB1" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T8" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="B1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T4" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G1" targetRef="T5" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G1" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T5" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="M1" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G2" targetRef="C1" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="G2" targetRef="M2" name="Không" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="C1" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="M2" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T6" targetRef="E2" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Số lượng dịch vụ HDV xác nhận là căn cứ đối chiếu hóa đơn NCC (C09-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="SUB1" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Chi từ tạm ứng phải có ảnh chứng từ; hóa đơn từ 5 triệu không trả tiền mặt (C09-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="SUB1" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>HDV và Điều hành không tự duyệt chi vượt ngưỡng (C09-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T5" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Mọi sự cố có mức độ và hạn xử lý; quá hạn tự leo thang (C09-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="T3" targetRef="N4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP09" name="BP-09 Thực hiện tour và xử lý sự cố">
    <bpmndi:BPMNPlane id="Plane_BP09" bpmnElement="Collab_BP09">
