      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="652" y="296" /><di:waypoint x="652" y="654" /><di:waypoint x="724" y="654" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="792" y="698" /><di:waypoint x="792" y="794" /><di:waypoint x="900" y="794" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1036" y="794" /><di:waypoint x="1118" y="794" /></bpmndi:BPMNEdge>
