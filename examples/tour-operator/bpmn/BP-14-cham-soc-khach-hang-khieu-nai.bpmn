    <bpmn:sequenceFlow id="Flow_25" sourceRef="R1" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="G4" targetRef="M4" name="Không">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="G4" targetRef="G5" name="Có" />
