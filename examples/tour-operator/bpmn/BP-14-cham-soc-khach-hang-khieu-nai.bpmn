    <bpmn:sequenceFlow id="Flow_33" sourceRef="T10" targetRef="E3" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Mọi khiếu nại thành phiếu có hạn xử lý; quá hạn tự leo thang (C14-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T3" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người đề xuất đền bù khác người duyệt (C14-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T7" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Đền bù bằng tiền đi qua BP-13, không chi ngoài hệ thống (C14-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="C3" targetRef="N3" />
  </bpmn:process>
