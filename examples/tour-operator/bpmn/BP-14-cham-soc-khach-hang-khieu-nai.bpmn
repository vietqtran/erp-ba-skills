      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="G2" targetRef="M2" name="Không" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T5" targetRef="M2" />
