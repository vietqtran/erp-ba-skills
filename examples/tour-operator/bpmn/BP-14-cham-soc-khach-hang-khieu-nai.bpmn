    <bpmn:sequenceFlow id="Flow_6" sourceRef="C1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="G1" targetRef="T2" name="Đạt" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T2" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G1" targetRef="M1" name="Không đạt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không đạt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="S2" targetRef="M1" />
