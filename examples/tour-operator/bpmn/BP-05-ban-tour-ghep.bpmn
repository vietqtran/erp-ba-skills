<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP05" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP05">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Bán tour ghép" processRef="Process_BP05" />
    <bpmn:participant id="P_KH" name="Khách hàng / Đại lý / OTA" />
    <bpmn:participant id="P_NH" name="Ngân hàng / Cổng thanh toán" />
    <bpmn:messageFlow id="MF_1" name="Yêu cầu đặt chỗ" sourceRef="P_KH" targetRef="S1" />
    <bpmn:messageFlow id="MF_2" name="Hết chỗ, phương án khác" sourceRef="T3" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_3" name="Hợp đồng, đề nghị cọc" sourceRef="T8" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_4" name="Báo có tiền cọc" sourceRef="P_NH" targetRef="R1" />
    <bpmn:messageFlow id="MF_5" name="Nhắc bổ sung cọc" sourceRef="T10" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_6" name="Xác nhận booking" sourceRef="T12" targetRef="P_KH" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP05" name="BP-05 Bán tour ghép: giữ chỗ, thu cọc, xác nhận booking" isExecutable="false">
    <bpmn:documentation>Nhận đặt chỗ cho chuyến khởi hành đang mở bán (tour ghép / series) mà không bán quá số chỗ, thu cọc đúng chính sách và xác nhận booking trên cùng một bộ số với Điều hành và Kế toán.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP05">
      <bpmn:lane id="Lane_SALES" name="Kinh doanh (Sales / Booking)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SALES_MGR" name="Trưởng phòng Kinh doanh">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Nhận yêu cầu đặt chỗ">
      <bpmn:documentation>Yêu cầu đến từ website, hotline, đại lý hoặc OTA. Booking từ OTA/website được tạo tự động qua tích hợp.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Tạo booking nháp: chuyến, số khách, hạng phòng">
      <bpmn:documentation>Chọn chuyến khởi hành, số khách theo độ tuổi (người lớn / trẻ em / em bé), số phòng và loại phòng, kênh bán, khách hàng (tra danh mục, không gõ tự do).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Kiểm tra chỗ khả dụng (ATP)">
      <bpmn:documentation>Chỗ khả dụng = sức chứa chuyến − chỗ đã xác nhận − chỗ đang giữ; đồng thời kiểm tra quỹ phòng/ghế của chuyến (allotment).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Còn đủ chỗ?" default="Flow_6">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T3" name="Báo hết chỗ, đề xuất chuyến khác">
      <bpmn:documentation>Đề xuất ngày khởi hành khác hoặc đưa khách vào danh sách chờ của chuyến.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Chưa đặt được">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T4" name="Tính giá và áp ưu đãi">
      <bpmn:documentation>Giá theo bảng giá chuyến: người lớn / trẻ em / em bé, phụ thu phòng đơn, giá kênh (đại lý, OTA), chương trình khuyến mãi, ưu đãi đặt sớm.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Ưu đãi vượt hạn mức nhân viên?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Duyệt hoặc điều chỉnh ưu đãi">
      <bpmn:documentation>Trưởng phòng duyệt, hoặc hạ mức ưu đãi về trong thẩm quyền. Không duyệt thì áp mức tối đa của nhân viên.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="Đại lý mua công nợ?" default="Flow_13">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Kiểm tra hạn mức công nợ">
      <bpmn:documentation>Dư nợ + booking đã xác nhận chưa xuất hóa đơn + booking này ≤ hạn mức × (1 + dung sai).</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5" name="Trong hạn mức?" default="Flow_16">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T8" name="Giữ chỗ, gửi hợp đồng và đề nghị cọc">
      <bpmn:documentation>Hệ thống giữ chỗ tới hạn giữ chỗ; gửi khách hợp đồng lữ hành (ký điện tử), số tiền cọc, hạn cọc và thông tin chuyển khoản / link thanh toán.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M5" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="R1" name="Nhận báo có tiền cọc">
      <bpmn:documentation>Nhận báo có từ ngân hàng / cổng thanh toán qua tích hợp (hoặc nhập sao kê), nội dung chuyển khoản có mã booking.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B1" name="Hết hạn giữ chỗ" attachedToRef="R1">
      <bpmn:documentation>Hết hạn giữ chỗ mà chưa nhận cọc.</bpmn:documentation>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_B1" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T13" name="Hủy giữ chỗ, trả chỗ về chuyến">
      <bpmn:documentation>Hệ thống tự hủy booking, cộng lại chỗ khả dụng và báo nhân viên kinh doanh.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Booking hết hạn">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T9" name="Đối chiếu tiền về, ghi phiếu thu cọc">
      <bpmn:documentation>Khớp giao dịch ngân hàng với booking; ghi phiếu thu và hạch toán vào công nợ khách (ứng trước).</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6" name="Đủ cọc tối thiểu?" default="Flow_26">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T10" name="Nhắc khách bổ sung cọc">
      <bpmn:documentation>Gửi thông báo số còn thiếu; hạn giữ chỗ không đổi.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M4" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T11" name="Xác nhận booking, lập lịch thu">
      <bpmn:documentation>Chuyển booking sang Đã xác nhận, trừ chỗ chính thức, cập nhật số khách của chuyến, sinh lịch thu phần còn lại (hạn thanh toán đủ trước ngày khởi hành).</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T12" name="Gửi xác nhận booking cho khách">
      <bpmn:documentation>Gửi xác nhận kèm hợp đồng đã ký, lịch thanh toán và yêu cầu bổ sung thông tin khách (họ tên, giấy tờ).</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E3" name="Booking đã xác nhận">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:messageEventDefinition id="Def_E3" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="G1" targetRef="T3" name="Không">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T3" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G1" targetRef="T4" name="Có" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="G2" targetRef="T5" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G2" targetRef="M2" name="Không" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T5" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="M2" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G4" targetRef="T6" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G4" targetRef="M3" name="Không" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T6" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="G5" targetRef="M3" name="Vượt hạn mức">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Vượt hạn mức</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="G5" targetRef="M4" name="Trong hạn mức" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="M3" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T8" targetRef="M5" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="M5" targetRef="R1" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="B1" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T13" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="R1" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T9" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="G6" targetRef="T10" name="Chưa đủ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="T10" targetRef="M5" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="G6" targetRef="M4" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="M4" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="T12" targetRef="E3" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Chặn bán quá chỗ: chỗ đang giữ tính như đã bán (C05-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T2" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người lập booking không tự duyệt ưu đãi của mình (C05-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T5" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Chỉ Kế toán ghi phiếu thu; Sales không sửa được (C05-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T9" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Chỉ xác nhận khi đủ cọc hoặc trong hạn mức công nợ (C05-06)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="T11" targetRef="N4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP05" name="BP-05 Bán tour ghép: giữ chỗ, thu cọc, xác nhận booking">
    <bpmndi:BPMNPlane id="Plane_BP05" bpmnElement="Collab_BP05">
      <bpmndi:BPMNShape id="P_MAIN_di" bpmnElement="P_MAIN" isHorizontal="true"><dc:Bounds x="100" y="164" width="3950" height="840" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SALES_di" bpmnElement="Lane_SALES" isHorizontal="true"><dc:Bounds x="130" y="164" width="3920" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SALES_MGR_di" bpmnElement="Lane_SALES_MGR" isHorizontal="true"><dc:Bounds x="130" y="444" width="3920" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SYS_di" bpmnElement="Lane_SYS" isHorizontal="true"><dc:Bounds x="130" y="584" width="3920" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ACC_di" bpmnElement="Lane_ACC" isHorizontal="true"><dc:Bounds x="130" y="864" width="3920" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_KH_di" bpmnElement="P_KH" isHorizontal="true"><dc:Bounds x="100" y="40" width="3950" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_NH_di" bpmnElement="P_NH" isHorizontal="true"><dc:Bounds x="100" y="1068" width="3950" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="250" y="216" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="218" y="258" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="374" y="190" width="136" height="88" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="550" y="610" width="136" height="88" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="768" y="629" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="742" y="685" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="900" y="330" width="136" height="88" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1124" y="356" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1092" y="398" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
