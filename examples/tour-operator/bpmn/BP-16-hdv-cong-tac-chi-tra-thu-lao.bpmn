<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP16" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP16">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — HDV cộng tác" processRef="Process_BP16" />
    <bpmn:participant id="P_HDV" name="Hướng dẫn viên cộng tác" />
    <bpmn:messageFlow id="MF_1" name="Hồ sơ" sourceRef="P_HDV" targetRef="S1" />
    <bpmn:messageFlow id="MF_2" name="Hợp đồng" sourceRef="T2" targetRef="P_HDV" />
    <bpmn:messageFlow id="MF_3" name="Hợp đồng đã ký, cam kết" sourceRef="P_HDV" targetRef="T2" />
    <bpmn:messageFlow id="MF_4" name="Nhắc gia hạn thẻ" sourceRef="T9" targetRef="P_HDV" />
    <bpmn:messageFlow id="MF_5" name="Thù lao" sourceRef="T8" targetRef="P_HDV" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP16" name="BP-16 Hướng dẫn viên cộng tác: hồ sơ, hạn thẻ và chi trả thù lao" isExecutable="false">
    <bpmn:documentation>Chỉ phân công HDV có thẻ còn hạn đúng loại; thù lao tính từ ngày công thực tế và đơn giá đã duyệt, ghi vào chi phí của đúng tour trước khi quyết toán, khấu trừ thuế TNCN đúng quy định và chi qua ngân hàng.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP16">
      <bpmn:lane id="Lane_HR" name="Hành chính – Nhân sự">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASH" name="Kế toán thanh toán / Thủ quỹ">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Nhận hồ sơ HDV mới hoặc gia hạn">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Kiểm tra thẻ HDV, ngoại ngữ, giấy tờ, mã số thuế">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Đủ điều kiện?" default="Flow_4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Từ chối hồ sơ">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T2" name="Ký hợp đồng cộng tác, nhận cam kết thuế">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T3" name="Kích hoạt hồ sơ HDV: tuyến, ngôn ngữ, đơn giá, hạn thẻ">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Sẵn sàng phân công">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S3" name="Thẻ HDV còn N ngày hết hạn">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S3" />
    </bpmn:startEvent>
    <bpmn:sendTask id="T9" name="Nhắc gia hạn; khóa phân công sau ngày hết hạn">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E4" name="Đã cảnh báo">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Tour kết thúc, phân công HDV hoàn thành">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T4" name="Tính thù lao: ngày công × đơn giá + phụ cấp">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Thuộc diện khấu trừ 10% TNCN?" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T5" name="Tính khấu trừ 10% TNCN">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Kiểm tra bảng thù lao, ghi nhận chi phí tour">
      <bpmn:documentation>Ghi trước khi đóng hồ sơ tour (BP-10); cấn trừ tạm ứng còn lại của HDV nếu có.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T7" name="Duyệt chi thù lao">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T8" name="Chi chuyển khoản cho HDV">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T10" name="Ghi sổ thanh toán, lập chứng từ khấu trừ TNCN">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E3" name="Đã chi trả thù lao">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="G1" targetRef="E1" name="Không">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="G1" targetRef="T2" name="Có" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T3" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S3" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T9" targetRef="E4" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="S2" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="G2" targetRef="T5" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G2" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T5" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T8" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T10" targetRef="E3" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Chỉ HDV có thẻ còn hạn đúng loại mới được kích hoạt (C16-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T1" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Ngày công lấy từ phân công đã hoàn thành, đơn giá từ hồ sơ (C16-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T4" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Người sửa tài khoản ngân hàng HDV khác người tính và người chi (C16-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T8" targetRef="N3" />
  </bpmn:process>
