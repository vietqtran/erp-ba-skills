<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP02" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP02">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Hợp đồng NCC" processRef="Process_BP02" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:messageFlow id="MF_1" name="Yêu cầu báo giá" sourceRef="T2" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_2" name="Báo giá" sourceRef="P_NCC" targetRef="R1" />
    <bpmn:messageFlow id="MF_3" name="Hợp đồng" sourceRef="T7" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_4" name="Hợp đồng đã ký" sourceRef="P_NCC" targetRef="T7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP02" name="BP-02 Hợp đồng nhà cung cấp, bảng giá theo mùa và quỹ chỗ (allotment)" isExecutable="false">
    <bpmn:documentation>Có giá mua đã thỏa thuận và quỹ chỗ đã cam kết với NCC trước mùa bán, để giá thành tour và chỗ bán ra đều lấy từ một nguồn đã duyệt.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP02">
      <bpmn:lane id="Lane_PROD" name="Sản phẩm &amp; Hợp đồng NCC">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROD_MGR" name="Trưởng phòng Sản phẩm">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DIR" name="Ban Giám đốc">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Chuẩn bị mùa mới hoặc hợp đồng sắp hết hạn">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Xác định nhu cầu: điểm đến, hạng dịch vụ, sản lượng">
      <bpmn:documentation>Lấy sản lượng dự kiến theo tuyến và tháng từ kế hoạch S&amp;OP đã duyệt.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T2" name="Gửi yêu cầu báo giá cho các NCC">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="R1" name="Nhận báo giá theo mùa và điều kiện">
      <bpmn:documentation>Giá theo mùa và hạng phòng/loại xe, phụ thu, chính sách trẻ em, điều kiện hủy, hạn trả chỗ, điều khoản thanh toán.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="T3" name="So sánh, đàm phán, chọn NCC">
      <bpmn:documentation>Bảng so sánh tối thiểu 2–3 báo giá cho dịch vụ trọng yếu; tham chiếu điểm đánh giá NCC và lịch sử sự cố.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Soạn hợp đồng, bảng giá theo mùa, quỹ chỗ">
      <bpmn:documentation>Bảng giá theo mùa; quỹ chỗ (số phòng/ghế theo ngày), hạn trả chỗ (release), chính sách hủy NCC, điều khoản trả trước/ký quỹ.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Duyệt hợp đồng và bảng giá">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Duyệt?" default="Flow_10">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Vượt hạn mức hoặc có trả trước?" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Duyệt hợp đồng">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T7" name="Ký hợp đồng với NCC">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T8" name="Kích hoạt bảng giá theo mùa và quỹ chỗ">
      <bpmn:documentation>Bảng giá chỉ đọc với Kinh doanh/Điều hành; quỹ chỗ ghi số lượng theo ngày và hạn trả chỗ; đặt cảnh báo hết hạn hợp đồng.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Có trả trước hoặc ký quỹ?" default="Flow_18">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C1" name="BP-12 Thanh toán NCC &amp; công nợ phải trả" calledElement="Process_BP12">
      <bpmn:documentation>Lập đề nghị thanh toán trước / ký quỹ theo hợp đồng.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Giá và chỗ sẵn sàng cho thiết kế tour">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="R1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="R1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T3" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="M1" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T5" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G1" targetRef="M1" name="Trả lại">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Trả lại</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G1" targetRef="G2" name="Đồng ý" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="G2" targetRef="T6" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G2" targetRef="M2" name="Không" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T6" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M2" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T8" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="G3" targetRef="C1" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="G3" targetRef="M3" name="Không" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="C1" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="M3" targetRef="E1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Tối thiểu 2–3 báo giá; chấm điểm NCC (C02-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T3" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người đàm phán không tự duyệt hợp đồng của mình (C02-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T5" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Giá NCC chỉ vào hệ thống qua hợp đồng đã duyệt (C02-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T8" targetRef="N3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP02" name="BP-02 Hợp đồng nhà cung cấp, bảng giá theo mùa và quỹ chỗ (allotment)">
