<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP06" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP06">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Tour thiết kế riêng" processRef="Process_BP06" />
    <bpmn:participant id="P_KH" name="Khách hàng / Đại lý / OTA" />
    <bpmn:participant id="P_AI" name="Dịch vụ mô hình AI (LLM)" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:messageFlow id="MF_1" name="Yêu cầu tour" sourceRef="P_KH" targetRef="S1" />
    <bpmn:messageFlow id="MF_2" name="Từ chối" sourceRef="T2" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_3" name="Yêu cầu + dữ liệu kho" sourceRef="A4" targetRef="P_AI" />
    <bpmn:messageFlow id="MF_4" name="Bản nháp JSON" sourceRef="P_AI" targetRef="AR1" />
    <bpmn:messageFlow id="MF_5" name="Bản chào" sourceRef="T7" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_6" name="Chấp nhận" sourceRef="P_KH" targetRef="C1" />
    <bpmn:messageFlow id="MF_7" name="Yêu cầu sửa" sourceRef="P_KH" targetRef="C2" />
    <bpmn:messageFlow id="MF_8" name="Hỏi chỗ, giá" sourceRef="T4" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_9" name="Xác nhận chỗ, giá" sourceRef="P_NCC" targetRef="T4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP06" name="BP-06 Bán tour thiết kế riêng: yêu cầu → dựng chương trình (thủ công hoặc AI) → bản chào → chốt → cọc" isExecutable="false">
    <bpmn:documentation>Chuyển yêu cầu riêng của khách (đoàn gia đình, doanh nghiệp, MICE, inbound) thành chương trình có giá vốn thật theo ngày, được duyệt giá, khách chấp nhận một phiên bản cụ thể, ký hợp đồng và đặt cọc trước khi điều hành đặt dịch vụ. Chương trình được dựng theo một trong hai luồng song song: thủ công, hoặc xây bằng trợ lý AI — cả hai cùng đi qua các kiểm soát phía sau.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP06">
      <bpmn:lane id="Lane_SALES" name="Kinh doanh (Sales / Booking)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SALES_MGR" name="Trưởng phòng Kinh doanh">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Nhận yêu cầu tour riêng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Tạo cơ hội, ghi yêu cầu chi tiết">
      <bpmn:documentation>Ngày, số khách theo độ tuổi, điểm đến, hạng khách sạn, ngân sách, yêu cầu đặc biệt; bắt đầu tính hạn phản hồi.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Yêu cầu khả thi?" default="Flow_5">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T2" name="Phản hồi từ chối, ghi lý do">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Cơ hội đóng">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M0" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GM" name="Cách dựng chương trình?" default="Flow_7">
      <bpmn:documentation>Người dựng chọn cho từng lần dựng/sửa. Nhánh AI chỉ hiện khi tính năng đang bật; tắt thì chỉ còn thủ công.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A3" name="Chuẩn bị dữ liệu gửi AI: yêu cầu đã ẩn danh, kho dịch vụ có thật">
      <bpmn:documentation>Gửi yêu cầu (không kèm dữ liệu cá nhân), chương trình hiện tại nếu đang sửa, và kho id có thật AI được phép dùng: điểm đến, khách sạn đang hoạt động kèm hạng và giá, vé, hoạt động, vận chuyển. Yêu cầu thiếu thông tin tối thiểu (ngày, số ngày, số khách, điểm đến) thì không gọi AI mà báo người dựng bổ sung.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:property id="Prop_A3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_A3_D1"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>Prop_A3</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="AM1" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A4" name="Gửi yêu cầu dựng hoặc sửa cho mô hình AI">
      <bpmn:documentation>Lời nhắc hệ thống cố định, câu trả lời ép theo schema JSON; lần sửa gửi kèm câu yêu cầu bằng lời.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="AR1" name="Nhận bản nháp theo schema">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B1" name="Quá thời gian chờ hoặc lỗi kết nối" attachedToRef="AR1">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_B1" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="A5" name="Kiểm tra bản nháp: schema, số ngày, id có thật, giới hạn">
      <bpmn:documentation>Loại cả bản nếu: sai schema, số ngày khai không khớp số ngày đếm được (bị cắt cụt), id không có trong kho hoặc không thuộc chương trình, vượt trần số ngày / số hoạt động mỗi ngày.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="AG2" name="Bản nháp hợp lệ?" default="Flow_16">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="AG3" name="Đã thử lại?" default="Flow_19">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A6" name="Ghi bản nháp, đồng bộ chặng, phòng, suất ăn; tính giá; ghi nhật ký">
      <bpmn:documentation>Ghi trong một giao dịch (lỗi thì hoàn tác toàn bộ). Trường AI không nói tới thì giữ nguyên. Hệ thống tự dựng lại chặng bay, xe, HDV, bố trí phòng, định mức ăn; giá vốn và giá bán do hệ thống tính từ bảng giá, không lấy số AI viết. Lưu phiên bản và nhật ký AI.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_A6_D2"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="A7" name="Rà soát chương trình AI dựng, đối chiếu yêu cầu khách">
      <bpmn:documentation>Kiểm tra lịch trình, khách sạn, lời văn, tổng giá so ngân sách; xem nhật ký từng thay đổi AI đã làm.</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AG4" name="Cần sửa tiếp?" default="Flow_26">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A8" name="Gõ yêu cầu sửa bằng lời">
      <bpmn:documentation>Ví dụ: thêm 1 ngày ở Đà Nẵng, đổi sang khách sạn 5 sao, bỏ bữa tối ngày 3.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MF" name="">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="MT" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Dựng chương trình thủ công từ mẫu hoặc module tour">
      <bpmn:documentation>Mỗi lần sửa tạo phiên bản mới của chương trình. Khi đến từ đường lui AI: chương trình hiện có giữ nguyên, hệ thống báo lý do lỗi và đưa gợi ý từ bộ luật để người dựng tự chọn áp dụng.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MD" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Kiểm tra chỗ và giá NCC theo ngày">
      <bpmn:documentation>Hỏi khách sạn, nhà xe chỗ trống cho ngày cụ thể; ghi giá NCC xác nhận nếu khác bảng giá. Áp như nhau cho chương trình dựng thủ công hay bằng AI.</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Tính giá thành, giá bán, lãi dự kiến">
      <bpmn:documentation>Như BP-03; so tổng giá với ngân sách khách.</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Dưới biên tối thiểu hoặc giảm giá vượt hạn mức?" default="Flow_31">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Duyệt giá">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T7" name="Gửi bản chào (link riêng hoặc PDF)">
      <bpmn:documentation>Bản chào có lịch trình, giá trọn gói, dịch vụ bao gồm/không bao gồm, chính sách hủy, hạn hiệu lực.</bpmn:documentation>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="EG1" name="Chờ phản hồi">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C1" name="Khách chấp nhận">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_C1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C2" name="Khách yêu cầu sửa">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_C2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C3" name="Hết hạn bản chào">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_C3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E2" name="Cơ hội thua (hết hạn)">
      <bpmn:incoming>Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T9" name="Chốt: tạo booking, hợp đồng, lịch thanh toán">
      <bpmn:documentation>Booking gắn đúng phiên bản chương trình khách chấp nhận; hợp đồng lữ hành có điều khoản hủy.</bpmn:documentation>
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="C4" name="BP-11 Thu tiền &amp; công nợ phải thu" calledElement="Process_BP11">
      <bpmn:documentation>Thu cọc theo lịch thanh toán.</bpmn:documentation>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G3" name="Nhận đủ cọc đúng hạn?" default="Flow_43">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Xác nhận booking, mở hồ sơ điều hành">
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="C6" name="BP-13 Thay đổi, hủy booking &amp; hoàn tiền" calledElement="Process_BP13">
      <bpmn:documentation>Hủy booking theo chính sách khi không cọc.</bpmn:documentation>
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E4" name="Booking hủy">
      <bpmn:incoming>Flow_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="C5" name="BP-08 Đặt dịch vụ &amp; chuẩn bị đoàn" calledElement="Process_BP08">
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E3" name="Đã chuyển điều hành">
      <bpmn:incoming>Flow_47</bpmn:incoming>
    </bpmn:endEvent>
