    <bpmn:textAnnotation id="N5"><bpmn:text>Không gửi tên, hộ chiếu, liên lạc của khách cho AI (C06-08)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N5" associationDirection="None" sourceRef="A3" targetRef="N5" />
    <bpmn:textAnnotation id="N6"><bpmn:text>Bản nháp sai bị loại cả bản, thử lại đúng một lần (C06-09)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N6" associationDirection="None" sourceRef="A5" targetRef="N6" />
    <bpmn:textAnnotation id="N7"><bpmn:text>AI chỉ lập nháp; người dựng rà soát, chịu trách nhiệm; AI không gửi khách, không đặt dịch vụ (C06-07)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N7" associationDirection="None" sourceRef="A7" targetRef="N7" />
    <bpmn:textAnnotation id="N8"><bpmn:text>AI lỗi: giữ nguyên chương trình, chuyển dựng thủ công (C06-12)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N8" associationDirection="None" sourceRef="MF" targetRef="N8" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Giá riêng vượt dự toán quá ngưỡng phải Trưởng Điều hành duyệt (C06-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T4" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người lập báo giá không tự duyệt (C06-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T6" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Chỉ đặt dịch vụ sau khi nhận cọc, trừ đại lý trong hạn mức (C06-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T9" targetRef="N3" />
  </bpmn:process>
