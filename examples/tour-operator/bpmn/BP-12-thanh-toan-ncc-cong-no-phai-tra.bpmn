<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP12" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP12">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Công nợ phải trả" processRef="Process_BP12" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:participant id="P_CQT" name="Cơ quan thuế (hệ thống HĐĐT)" />
    <bpmn:participant id="P_NH" name="Ngân hàng / Cổng thanh toán" />
    <bpmn:messageFlow id="MF_1" name="Hóa đơn / đề nghị" sourceRef="P_NCC" targetRef="S1" />
    <bpmn:messageFlow id="MF_2" name="Tra cứu hóa đơn" sourceRef="T1" targetRef="P_CQT" />
    <bpmn:messageFlow id="MF_3" name="Kết quả" sourceRef="P_CQT" targetRef="T1" />
    <bpmn:messageFlow id="MF_4" name="Xác minh" sourceRef="T3" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_5" name="Giải trình" sourceRef="P_NCC" targetRef="T3" />
    <bpmn:messageFlow id="MF_6" name="Yêu cầu điều chỉnh" sourceRef="T4" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_7" name="Lệnh chi" sourceRef="T9" targetRef="P_NH" />
    <bpmn:messageFlow id="MF_8" name="Báo nợ" sourceRef="P_NH" targetRef="R2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP12" name="BP-12 Thanh toán nhà cung cấp và công nợ phải trả" isExecutable="false">
    <bpmn:documentation>Chỉ trả tiền cho dịch vụ đã đặt, đã thực sự dùng và có hóa đơn hợp lệ; cấn trừ đủ các khoản đã trả trước; duyệt chi theo hạn mức; chi qua ngân hàng hai lớp.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP12">
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DIR" name="Ban Giám đốc">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASH" name="Kế toán thanh toán / Thủ quỹ">
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Nhận hóa đơn hoặc đề nghị trả trước">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0" name="Loại chứng từ?" default="Flow_2">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T1" name="Xác thực hóa đơn với CQT, kiểm tra trùng, NCC rủi ro">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Đối chiếu 3 chiều: đơn đặt, xác nhận đã dùng, hóa đơn">
      <bpmn:documentation>Số lượng hóa đơn ≤ số lượng HDV xác nhận đã dùng; đơn giá trong dung sai so với đơn đặt; đúng mã tour.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Khớp trong dung sai?" default="Flow_6">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Xác minh chênh lệch với NCC và HDV">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Chênh lệch được chấp nhận?" default="Flow_10">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T4" name="Yêu cầu NCC điều chỉnh hoặc thay thế hóa đơn">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E2" name="Chờ hóa đơn điều chỉnh">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Ghi sổ hóa đơn, cấn trừ trả trước">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Đề xuất lô thanh toán theo hạn và số dư tiền">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T7" name="Duyệt đề nghị thanh toán">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Vượt hạn mức Kế toán trưởng?" default="Flow_18">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Duyệt chi">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T9" name="Lập ủy nhiệm chi trên ngân hàng điện tử">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="R2" name="Nhận báo nợ">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="T11" name="Ghi sổ thanh toán, đối trừ công nợ NCC">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Đã thanh toán NCC">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="G0" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="G0" targetRef="T1" name="Hóa đơn" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="G0" targetRef="M2" name="Trả trước theo hợp đồng">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Trả trước theo hợp đồng</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G1" targetRef="M1" name="Khớp" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="G1" targetRef="T3" name="Lệch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Lệch</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G2" targetRef="M1" name="Chấp nhận">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chấp nhận</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G2" targetRef="T4" name="Không" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T4" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="M1" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T5" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M2" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T7" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="G3" targetRef="T8" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="G3" targetRef="M3" name="Không" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T8" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="M3" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T9" targetRef="R2" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="R2" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T11" targetRef="E1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Không trả tiền cho dịch vụ chưa được xác nhận đã dùng (C12-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T2" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người ghi hóa đơn, người duyệt, người chi là ba người khác nhau (C12-04)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T7" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Lệnh chi hai lớp: lập trên ERP, duyệt trên ngân hàng (C12-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T9" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Bắt buộc cấn trừ khoản đã trả trước (C12-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="T5" targetRef="N4" />
  </bpmn:process>
