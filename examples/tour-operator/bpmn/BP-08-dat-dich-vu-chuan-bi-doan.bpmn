      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1118" y="769" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1014" y="735" width="100" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="1250" y="470" width="136" height="88" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M1_di" bpmnElement="M1" isMarkerVisible="true"><dc:Bounds x="1468" y="769" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1600" y="190" width="136" height="88" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R1_di" bpmnElement="R1"><dc:Bounds x="1774" y="190" width="136" height="88" /></bpmndi:BPMNShape>
