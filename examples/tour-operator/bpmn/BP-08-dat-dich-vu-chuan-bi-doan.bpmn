<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP08" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP08">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Đặt dịch vụ &amp; chuẩn bị đoàn" processRef="Process_BP08" />
    <bpmn:participant id="P_NCC" name="Nhà cung cấp dịch vụ (khách sạn, xe, nhà hàng, vé, hàng không)" />
    <bpmn:participant id="P_KH1" name="Khách hàng" />
    <bpmn:messageFlow id="MF_1" name="Đơn đặt dịch vụ" sourceRef="T5" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_2" name="Xác nhận / từ chối" sourceRef="P_NCC" targetRef="R1" />
    <bpmn:messageFlow id="MF_3" name="Rooming list" sourceRef="T9" targetRef="P_NCC" />
    <bpmn:messageFlow id="MF_4" name="Lịch trình cuối" sourceRef="T10" targetRef="P_KH1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP08" name="BP-08 Đặt dịch vụ nhà cung cấp và chuẩn bị đoàn" isExecutable="false">
    <bpmn:documentation>Mọi dịch vụ trong chương trình được đặt với đúng NCC, đúng giá hợp đồng, có mã xác nhận; HDV và xe được phân công; hồ sơ đoàn đầy đủ và checklist bắt buộc hoàn tất trước ngày khởi hành.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP08">
      <bpmn:lane id="Lane_OPS" name="Điều hành (Operator)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OPS_MGR" name="Trưởng Điều hành">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GUIDE" name="Hướng dẫn viên">
        <bpmn:flowNodeRef>T8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đoàn đã xác nhận hoặc chuyến bảo đảm khởi hành">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Mở hồ sơ điều hành, sinh dịch vụ cần đặt và checklist">
      <bpmn:documentation>Sinh từ chương trình đã chốt: mỗi khách sạn, mỗi NCC một dòng (số phòng × đêm, số suất, ngày dùng); checklist theo mốc D-21…D+10 có người phụ trách và hạn.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="Kiểm tra thông tin bàn giao">
      <bpmn:documentation>Số khách theo độ tuổi, rooming, yêu cầu đặc biệt (ăn chay, dị ứng, VIP), giấy tờ, điều khoản.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M0" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Tạo đơn đặt dịch vụ theo NCC, giá hợp đồng">
      <bpmn:documentation>Gom dòng dịch vụ theo NCC; giá mặc định từ bảng giá hợp đồng theo ngày sử dụng.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Giá khác hợp đồng hoặc vượt dự toán?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Duyệt giá NCC">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T5" name="Gửi đơn đặt dịch vụ cho NCC">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="R1" name="Ghi nhận phản hồi NCC">
      <bpmn:documentation>Ghi mã xác nhận và giá NCC xác nhận; hệ thống cập nhật lãi dự kiến của tour.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G2" name="NCC xác nhận?" default="Flow_14">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Chọn NCC thay thế hoặc báo Kinh doanh đổi chương trình">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="NCC yêu cầu trả trước?" default="Flow_16">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C1" name="BP-12 Thanh toán NCC &amp; công nợ phải trả" calledElement="Process_BP12">
      <bpmn:documentation>Đề nghị thanh toán trước theo điều khoản của NCC.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T9" name="Gửi rooming list, danh sách đoàn cho NCC">
      <bpmn:documentation>Mốc D-7; kèm yêu cầu đặc biệt. Mua bảo hiểm du lịch cho đoàn nếu thuộc phạm vi hợp đồng.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T8" name="Phân công HDV, xe">
      <bpmn:documentation>Chọn HDV theo ngôn ngữ, tuyến; hệ thống chặn trùng lịch và thẻ HDV hết hạn; tỷ lệ HDV theo số khách.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T8b" name="Xác nhận nhận tour">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T11" name="Kiểm tra checklist bắt buộc trước khởi hành">
      <bpmn:documentation>Tất cả dịch vụ đã xác nhận, rooming list đã gửi, HDV đã nhận, khách đã thanh toán đủ theo lịch.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Đủ điều kiện khởi hành?" default="Flow_29">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T12" name="Xử lý việc tồn, leo thang">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T10" name="Gửi lịch trình cuối và thông tin HDV cho khách">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T13" name="Bàn giao hồ sơ đoàn, lệnh điều tour, tạm ứng">
      <bpmn:documentation>Hồ sơ đoàn, danh sách khách, mã xác nhận NCC, lệnh điều tour; đề nghị tạm ứng theo dự toán chi tại điểm.</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T14" name="Nhận hồ sơ và tạm ứng, ký nhận">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Đoàn sẵn sàng khởi hành">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="M0" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="M0" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G1" targetRef="T4" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="G1" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T4" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="M1" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T5" targetRef="R1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="R1" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G2" targetRef="T6" name="Từ chối hoặc hết chỗ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Từ chối hoặc hết chỗ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T6" targetRef="M0" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="G2" targetRef="G3" name="Xác nhận" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="G3" targetRef="C1" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="G3" targetRef="M2" name="Không" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="C1" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="M2" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="P1" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="P1" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T8" targetRef="T8b" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T9" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T8b" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="P2" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="M3" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="T11" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="G4" targetRef="T12" name="Chưa đủ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Chưa đủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="T12" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="G4" targetRef="T10" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="T10" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="T14" targetRef="E1" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Giá đặt lấy từ hợp đồng; lệch quá ngưỡng phải duyệt (C08-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T3" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Chưa có mã xác nhận là chưa đặt được; quá hạn tự leo thang (C08-03)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="R1" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Chặn trùng lịch và thẻ HDV hết hạn (C08-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T8" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Còn việc bắt buộc chưa xong thì không khởi hành (C08-06)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="T11" targetRef="N4" />
    <bpmn:textAnnotation id="N5"><bpmn:text>Không tạm ứng khi HDV còn tạm ứng quá hạn (C08-07)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N5" associationDirection="None" sourceRef="T13" targetRef="N5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP08" name="BP-08 Đặt dịch vụ nhà cung cấp và chuẩn bị đoàn">
    <bpmndi:BPMNPlane id="Plane_BP08" bpmnElement="Collab_BP08">
      <bpmndi:BPMNShape id="P_MAIN_di" bpmnElement="P_MAIN" isHorizontal="true"><dc:Bounds x="100" y="164" width="4825" height="700" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OPS_di" bpmnElement="Lane_OPS" isHorizontal="true"><dc:Bounds x="130" y="164" width="4795" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OPS_MGR_di" bpmnElement="Lane_OPS_MGR" isHorizontal="true"><dc:Bounds x="130" y="444" width="4795" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GUIDE_di" bpmnElement="Lane_GUIDE" isHorizontal="true"><dc:Bounds x="130" y="584" width="4795" height="140" /></bpmndi:BPMNShape>
