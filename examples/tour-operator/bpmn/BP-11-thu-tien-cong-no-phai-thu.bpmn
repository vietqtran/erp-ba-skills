<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP11" targetNamespace="http://tour-erp.local/bpmn" exporter="tour-erp-bpmn (bpmn_gen.py)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_BP11">
    <bpmn:participant id="P_MAIN" name="Công ty lữ hành — Công nợ phải thu" processRef="Process_BP11" />
    <bpmn:participant id="P_KH" name="Khách hàng / Đại lý / OTA" />
    <bpmn:participant id="P_CQT" name="Cơ quan thuế (hệ thống HĐĐT)" />
    <bpmn:participant id="P_NH" name="Ngân hàng / Cổng thanh toán" />
    <bpmn:messageFlow id="MF_1" name="Hóa đơn cần cấp mã" sourceRef="T4" targetRef="P_CQT" />
    <bpmn:messageFlow id="MF_2" name="Mã của CQT" sourceRef="P_CQT" targetRef="T4" />
    <bpmn:messageFlow id="MF_3" name="Đề nghị thanh toán, hóa đơn" sourceRef="T5" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_4" name="Báo có" sourceRef="P_NH" targetRef="R1" />
    <bpmn:messageFlow id="MF_5" name="Biên bản đối chiếu" sourceRef="T11" targetRef="P_KH" />
    <bpmn:messageFlow id="MF_6" name="Xác nhận khớp" sourceRef="P_KH" targetRef="C2" />
    <bpmn:messageFlow id="MF_7" name="Báo lệch" sourceRef="P_KH" targetRef="C3" />
    <bpmn:messageFlow id="MF_8" name="Biên bản điều chỉnh" sourceRef="T12" targetRef="P_KH" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP11" name="BP-11 Thu tiền khách hàng và công nợ phải thu (kèm đối chiếu công nợ đại lý)" isExecutable="false">
    <bpmn:documentation>Thu đủ tiền theo lịch thanh toán của từng booking, xuất hóa đơn điện tử đúng thời điểm, ghi nhận tiền về đúng khách, nhắc nợ có cấp độ; đối chiếu công nợ với đại lý hằng kỳ và chốt số liệu.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP11">
      <bpmn:lane id="Lane_SALES" name="Kinh doanh (Sales / Booking)">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ACC" name="Kế toán công nợ">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CHIEF_ACC" name="Kế toán trưởng">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Hệ thống ERP">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đến mốc thu hoặc tour hoàn thành">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Tính số phải thu, xác định có phải lập hóa đơn">
      <bpmn:documentation>Theo lịch thanh toán của booking; đã trừ cọc. Quy tắc thời điểm: hoàn thành dịch vụ, hoặc thu tiền trước (khoản đặt cọc bảo đảm hợp đồng chưa phải lập).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Lập hóa đơn ở mốc này?" default="Flow_4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2" name="Lập hóa đơn từ booking">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T3" name="Kiểm tra, ký số hóa đơn">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T4" name="Gửi CQT cấp mã, ghi công nợ">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T5" name="Gửi đề nghị thanh toán kèm hóa đơn hoặc link thanh toán">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="R1" name="Nhận báo có">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B1" name="Quá hạn thanh toán" attachedToRef="R1">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_B1" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T6" name="Nhắc nợ, thỏa thuận gia hạn hoặc đề xuất hủy">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Gia hạn?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C1" name="BP-13 Thay đổi, hủy booking &amp; hoàn tiền" calledElement="Process_BP13">
      <bpmn:documentation>Hủy booking theo chính sách khi quá hạn trước khởi hành; sau tour thì chuyển xử lý nợ khó đòi.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E3" name="Booking hủy hoặc chuyển xử lý nợ">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T7" name="Khớp tiền về với booking, ghi phiếu thu">
      <bpmn:documentation>Khớp theo mã booking trong nội dung chuyển khoản; phân bổ theo hóa đơn cũ trước; tiền chưa rõ của ai thì treo chờ xử lý.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Thu đủ theo đề nghị?" default="Flow_19">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Cập nhật trạng thái thanh toán, đối trừ cọc">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Đã thu đủ">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Cuối kỳ đối chiếu công nợ đại lý">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S2" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T10" name="Lập biên bản đối chiếu theo đại lý">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T11" name="Kiểm tra và gửi biên bản cho đại lý">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M5" name="">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="EG1" name="Chờ đại lý phản hồi">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C2" name="Đại lý xác nhận khớp">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_C2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C3" name="Đại lý báo lệch">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_C3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C4" name="Hết hạn phản hồi: coi như xác nhận theo hợp đồng">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_C4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T12" name="Đối chiếu chênh lệch, điều chỉnh, gửi lại">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M6" name="">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T13" name="Chốt và khóa số liệu đối chiếu kỳ">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Công nợ đại lý đã chốt">
      <bpmn:incoming>Flow_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="G1" targetRef="T2" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="G1" targetRef="M1" name="Không" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T4" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="M1" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T5" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="M2" targetRef="R1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="B1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="G3" targetRef="M2" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="G3" targetRef="C1" name="Không" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="C1" targetRef="E3" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="R1" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T7" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="G2" targetRef="M2" name="Thu thiếu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Thu thiếu</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="G2" targetRef="T8" name="Đủ" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T8" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="S2" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T11" targetRef="M5" />
