    <bpmn:sequenceFlow id="Flow_29" sourceRef="T12" targetRef="M5" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="C2" targetRef="M6" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="C4" targetRef="M6" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="M6" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="T13" targetRef="E4" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Thời điểm lập hóa đơn do hệ thống xác định theo quy tắc (C11-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="T1" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Người lập hóa đơn khác người ký số (C11-02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="T3" targetRef="N2" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Phiếu thu sinh từ giao dịch ngân hàng; Kinh doanh không sửa được (C11-03, C11-06)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="T7" targetRef="N3" />
    <bpmn:textAnnotation id="N4"><bpmn:text>Số liệu đã chốt bị khóa (C11-05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N4" associationDirection="None" sourceRef="T13" targetRef="N4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP11" name="BP-11 Thu tiền khách hàng và công nợ phải thu (kèm đối chiếu công nợ đại lý)">
